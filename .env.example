# Copia questo file in .env.local e adatta i valori.
# Le variabili con prefisso NEXT_PUBLIC_ finiscono nel bundle inviato al browser:
# non metterci mai un segreto.

# Base URL del backend cinema-scheduler-be.
# Nota: il backend usa la porta 3000 di default, come Next.js. Se li esegui
# entrambi in locale, spostane uno (es. PORT=3001 lato backend).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Se true, le chiamate API sono intercettate da MSW e servite da mocks/fixtures/.
# Permette di sviluppare e testare senza backend attivo (issue #6).
NEXT_PUBLIC_USE_MOCKS=false

# URL da cui `npm run api:generate` scarica lo spec OpenAPI del backend (issue #4).
OPENAPI_SPEC_URL=http://localhost:3001/openapi.json

# next-auth (issue #11)
NEXTAUTH_URL=http://localhost:3000
# Obbligatorio, nessun default. Genera un valore con: openssl rand -base64 32
NEXTAUTH_SECRET=
